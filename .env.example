# PhotonVox settings. Copy to .env and fill in. Names only here: real values live in .env on the host (mode 600, git-ignored) and in Connor's
# password manager. Never commit .env.

# ---- database (three logins) ---------------------------------------------------------------------------------------------------------------
# The owner runs migrations only; the API logs in as vox_app and the worker as vox_system. 16 to 128 letters, digits, - or _ (openssl rand -hex 24).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=
# POSTGRES_USER=photonvox
# POSTGRES_DB=photonvox

# ---- sign-in: PhotonID ---------------------------------------------------------------------------------------------------------------------
OIDC_ISSUER=https://id.photonind.com
# The PhotonVox project id from PhotonID: tokens issued for any other Photon app are refused.
OIDC_AUDIENCE=
# Comma-separated, https only in production: the web app's origin. Development: http://localhost:5183
CORS_ORIGINS=https://vox.photonind.com
# PhotonVox's own web client id (the same value as VITE_OIDC_CLIENT_ID): a token issued to any other app is accepted on GET /v1/summary only.
# (Photon staff come from the directory; the old PLATFORM_ADMIN_SUBS setting is gone and ignored if still present.)
OIDC_WEB_CLIENT_ID=

# ---- the PhotonID directory ----------------------------------------------------------------------------------------------------------------
# Issued by the directory: `python -m app.manage connect-product vox` there (once `vox` is available in its catalog).
DIRECTORY_URL=https://api.account.photonind.com
DIRECTORY_CLIENT_ID=
DIRECTORY_CLIENT_SECRET=
DIRECTORY_NOTICE_SECRET=
# Fernet key for engine logins and phones' SIP passwords (required in production):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# ---- the web app (public values; they end up in the page) ----------------------------------------------------------------------------------
VITE_API_URL=https://api.vox.photonind.com
VITE_OIDC_ISSUER=https://id.photonind.com
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE_PROJECT=
VITE_DIRECTORY_APP_URL=https://account.photonind.com
# The app switcher: the directory's API and its PhotonID project (asked for at sign-in). Production 398636902653100035, dev 398336253029777411.
VITE_DIRECTORY_API_URL=https://api.account.photonind.com
VITE_DIRECTORY_AUDIENCE_PROJECT=

# ENVIRONMENT=production
# Development only (production publishes no ports: docker-compose.prod.yml):
# API_PORT=8113
# WEB_PORT=5183
