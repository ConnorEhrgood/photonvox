diff --git a/deploy/caddy/sites/vox.caddy.example b/deploy/caddy/sites/vox.caddy.example
new file mode 100644
index 0000000..b676f42
--- /dev/null
+++ b/deploy/caddy/sites/vox.caddy.example
@@ -0,0 +1,28 @@
+# vox.caddy.example (source: the photonvox repo's deploy/caddy/vox.caddy): PhotonVox's two names on the Photon host, where PhotonBoard's Caddy terminates TLS for every Photon service. Hostnames are spelled
+# out (no environment variables) so the site loads on a graceful reload: a new variable would need the proxy recreated, which drops its other
+# networks for a minute (found deploying the directory, b1). Copy to vox.caddy beside it,
+# connect the proxy to vox-edge, validate, reload: docs/DEPLOY.md.
+# DNS: grey cloud (DNS only), pointing at the host, as for the other names.
+#
+# The containers are addressed by their unique aliases on vox-edge (docker-compose.prod.yml), never by the bare service names.
+# The API trusts X-Forwarded-For from private addresses only (FORWARDED_ALLOW_IPS), so its sign-in throttle sees the real client.
+vox.photonind.com {
+	import secure
+	encode zstd gzip
+	# The web server (nginx) sets the page's Content-Security-Policy and the other security headers itself.
+	reverse_proxy vox-web:8080
+}
+
+api.vox.photonind.com {
+	import secure
+	encode zstd gzip
+	# Everything the API takes is JSON: a phone system's draft is the largest (the document's own limits keep it well under this).
+	request_body {
+		max_size 2MB
+	}
+	# Liveness, not readiness: a database blip must not make the proxy stop sending people to the API.
+	reverse_proxy vox-api:8000 {
+		health_uri /healthz
+		health_interval 15s
+	}
+}
diff --git a/docker-compose.vox-edge.yml b/docker-compose.vox-edge.yml
new file mode 100644
index 0000000..ca863d1
--- /dev/null
+++ b/docker-compose.vox-edge.yml
@@ -0,0 +1,16 @@
+# Overlay for serving PhotonVox (the photonvox repo, deployed on the host at /opt/photon/vox) from the same Caddy: the proxy joins PhotonVox's edge
+# network and serves its two names (vox.photonind.com, api.vox.photonind.com). Compose merges a service's networks across files, so this adds
+# vox-edge to whatever the other overlays give the proxy.
+#   docker network create --label photon.product=vox vox-edge   # once, before either stack starts (PhotonVox's docker-compose.prod.yml uses it too)
+#   cp deploy/caddy/sites/vox.caddy.example deploy/caddy/sites/vox.caddy
+# On a running host, do not recreate the proxy to add it (that drops its other networks for a minute): `docker network connect vox-edge
+# photonboard-proxy-1`, then validate and reload Caddy (photonvox docs/DEPLOY.md). This overlay keeps it there whenever the proxy IS recreated:
+# deploy-photon-host.sh and restore-host.sh include it when vox.caddy exists.
+services:
+  proxy:
+    networks: [default, vox-edge]
+
+networks:
+  vox-edge:
+    external: true
+    name: vox-edge
